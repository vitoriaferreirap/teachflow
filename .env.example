# Copie este arquivo para .env e preencha com seus dados

# PostgreSQL
PG_HOST=localhost
PG_DATABASE=web2_db
PG_USER=postgres
PG_PASSWORD=sua_senha_aqui

# MongoDB Atlas
MONGO_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/plataformaweb

# Servidor
PORT=8081

# Sessão (gere uma chave aleatória longa)
SESSION_SECRET=troque_por_uma_chave_aleatoria
