<div class="login-wrapper w-100">
    <div class="text-center mb-4">
        <h1 class="h3 fw-semibold">Área do aluno</h1>
        <p class="text-body-secondary">Entre com seu login e senha</p>
    </div>

    <div class="card">
        <div class="card-body p-4">
            {{#if erro}}
            <div class="alert alert-danger py-2 small" role="alert">{{erro}}</div>
            {{/if}}
            <form action="/login" method="post">
                <div class="mb-3">
                    <label for="login" class="form-label">Login</label>
                    <input type="text" class="form-control" name="login" id="login" value="{{login}}" required autofocus>
                </div>
                <div class="mb-4">
                    <label for="senha" class="form-label">Senha</label>
                    <input type="password" class="form-control" name="senha" id="senha" required>
                </div>
                <button type="submit" class="btn btn-primary w-100">Entrar</button>
            </form>
        </div>
    </div>

    <p class="text-center mt-3 small">
        <a href="/" class="text-body-secondary">&larr; Voltar ao site</a>
    </p>
</div>
